# 主密钥：用于 AES-256-GCM 加密服务商 API Key（必填，不写库不写日志，仅从环境变量读取）
# 生成方式：openssl rand -hex 32
# 也接受任意字符串（内部用 sha256 派生为 32 字节密钥），但推荐使用上面的随机 hex
MASTER_KEY=

# 可选：HTTPS 反向代理后的公开 origin，用于订阅登录同源校验与 Secure Cookie。
# 仅填写协议、域名和可选端口，不含路径/查询/用户名；不自动信任 forwarded 请求头。
# MODEL_CENTER_PUBLIC_ORIGIN=https://models.example.com

# 旧 Gemini CLI 账号刷新所需的 OAuth 客户端配置；仅在服务端部署环境填写。
# 使用与官方 Code Assist 授权码流程兼容的客户端配置，勿写进源码或提交环境文件。
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=

# Antigravity CLI 独立 OAuth 客户端（不能复用 Gemini CLI 客户端）。仅在服务端注入。
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
