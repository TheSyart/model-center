{
  "version": 1,
  "build": {
    "kind": "node",
    "packageManager": "npm",
    "install": "ci",
    "script": "build"
  },
  "publish": {
    "mode": "in_place"
  },
  "runtime": {
    "kind": "systemd",
    "unit": "model-center.service"
  },
  "health": {
    "kind": "http",
    "path": "/",
    "timeoutSeconds": 5
  }
}
