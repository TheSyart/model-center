    "lucide-react": "^1.34.0",
    "next": "^15.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tar-stream": "^3.2.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.0",
    "ws": "^8.21.3"
