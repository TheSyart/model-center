{
  "name": "model-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.mts",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit --incremental false",
    "sync:cc-switch": "node --experimental-strip-types scripts/sync-cc-switch.ts",
    "build": "next build",
    "start": "NODE_ENV=production node server.mts"
  },
  "dependencies": {
