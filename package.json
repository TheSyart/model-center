    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
