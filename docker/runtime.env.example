NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
MODEL_CENTER_DB_DIR=/app/data
# Inject the EXISTING key for this database; never rotate it during migration.
MASTER_KEY=

# Antigravity CLI 独立 OAuth 客户端（不能复用 Gemini CLI 客户端）。仅在服务端注入。
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# HTTPS ingress origin; required for subscription mutations behind a TLS proxy.
# MODEL_CENTER_PUBLIC_ORIGIN=https://models.example.com
# Gemini CLI OAuth client configuration, supplied only in the external env file.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
# Optional container-reachable HTTP(S) egress proxy for subscription traffic only.
# MODEL_CENTER_SUBSCRIPTION_PROXY_URL=http://host.docker.internal:7897
